# Backend Environment Configuration
PORT=3000
DATABASE_URL="postgresql://username:password@host/database?sslmode=require&connect_timeout=30"
# Generate an independent key for each environment using a CSPRNG (32 bytes minimum).
# Hex: 64+ characters; alternatively canonical padded base64 encoding of 32+ bytes.
# This placeholder is intentionally rejected. Never copy a real signing key into this file.
JWT_SECRET="replace-with-a-generated-jwt-secret"

# Configurable CORS Allowed Origins (comma-separated, exact origins)
# In development, defaults to: http://localhost:5173,http://127.0.0.1:5173
# In production, specify exact clinic dashboard origins (e.g. https://app.docmatrix.co.in)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Rate Limiting & Shared Store Configuration
# Options for RATE_LIMIT_STORE: memory (default for local dev) or redis (required for multi-instance production)
RATE_LIMIT_STORE="memory"
REDIS_URL="redis://localhost:6379"
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=5
RATE_LIMIT_FAIL_CLOSED=true

# Safer Brute-Force & Credential Protection
BRUTE_FORCE_MAX_FAILURES=5
BRUTE_FORCE_LOCKOUT_SECONDS=900

# Trusted Proxy Configuration
# Specify trusted reverse proxy CIDRs or hop counts (e.g. 'loopback', '10.0.0.0/8', or 1)
# Never set to wildcard true in production. In production, defaults to false if unset.
TRUSTED_PROXIES="loopback"

# Antivirus & Malware Scanning (ClamAV)
# In local development, defaults to built-in heuristic scanning
# In production, configure ClamAV daemon host and port:
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
SCANNER_REQUIRED=false

# Durable Centralized Audit Logging
# Structured JSON logs are automatically output to stdout for CloudWatch/Datadog/SIEM collectors
AUDIT_LOG_WEBHOOK_URL=""
AUDIT_LOG_API_KEY=""
# Audit history is append only. Apply retention at the verified immutable collector.



# Password recovery delivery webhook (must deliver the supplied resetUrl). HTTPS in production.
PUBLIC_APP_URL=""
PASSWORD_RESET_DELIVERY_URL=""
PASSWORD_RESET_DELIVERY_KEY=""

# Optional on Windows hosts with active Microsoft Defender; Linux uses ClamAV above.
# MALWARE_SCANNER="windows-defender"
# Recovery archives: set a random 32-byte hex key and escrow it separately.
# BACKUP_ENCRYPTION_KEY=""

# Required in production; 32 random bytes as hex, managed independently of JWT_SECRET.
AUTH_ENCRYPTION_KEY=""
ACCOUNT_EMAIL_DELIVERY_URL=""
ACCOUNT_EMAIL_DELIVERY_KEY=""
# Production startup requires Redis, HTTPS origins/email/audit URLs and ClamAV.
S3_ENCRYPTION="AES256"
S3_KMS_KEY_ID=""

# Dedicated backup identity and independent destination, configured in the recovery CI environment.
BACKUP_AWS_ACCESS_KEY_ID=""
BACKUP_AWS_SECRET_ACCESS_KEY=""
BACKUP_S3_BUCKET=""
BACKUP_ENDPOINT_URL=""
BACKUP_AWS_REGION=""
